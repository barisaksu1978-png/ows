---
import type { UiStrings } from '../../i18n';
import mapImg from '../../assets/intro-map.jpg';
import wordImg from '../../assets/curtain-word.png';
import owlImg from '../../assets/curtain-owl.png';
import '../../styles/intro.css';

interface Props {
  t: UiStrings;
}

const { t } = Astro.props;
---

<div id="intro-curtain">
  <div class="icv-curt icv-curt-l"></div>
  <div class="icv-curt icv-curt-r"></div>
  <div class="icv-stage">
    <div class="icv-owlclip"><div class="icv-owl"></div></div>
    <div class="icv-word"></div>
  </div>
  <button class="icv-skip" type="button">{t['curtain.skip']}</button>
</div>

<div id="intro-stage">
  <section class="screen scr show" id="intro">
    <div class="map-layer">
      <img src={mapImg.src} width={mapImg.width} height={mapImg.height} alt={t['map.alt']} />
      <div class="vignette"></div>
    </div>
    <div class="intro-content">
      <div class="scr-label">{t['intro.label']}</div>
      <p class="intro-title">{t['intro.title']}</p>
      <p class="intro-sub">{t['intro.subtitle']}</p>
    </div>
    <div class="intro-bottom">
      <div class="coords">
        <p class="intro-map-caption">{t['intro.map_caption']}</p>
        <p class="intro-map-note">{t['intro.map_note']}</p>
      </div>
      <button class="enter" type="button" id="intro-enter">
        <span>{t['intro.enter']}</span>
        <span>{t['intro.enter_arrow']}</span>
      </button>
    </div>
  </section>
</div>

<style is:global set:html={`
  :root {
    --word: url(${wordImg.src});
    --owl: url(${owlImg.src});
  }
`}></style>

<script src="./intro.ts"></script>
