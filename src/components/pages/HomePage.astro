---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDocumentTitle, getUi, type Locale } from '../../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = (Astro.currentLocale ?? 'tr') as Locale;
const t = getUi(locale);
const notItems = [1, 2, 3, 4, 5, 6] as const;
const previews = [
  { title: 'home.preview.method.title', body: 'home.preview.method.body', path: '/method/' },
  { title: 'home.preview.dossiers.title', body: 'home.preview.dossiers.body', path: '/dossiers/' },
  { title: 'home.preview.atlas.title', body: 'home.preview.atlas.body', path: '/atlas/' },
  { title: 'home.preview.human_ai.title', body: 'home.preview.human_ai.body', path: '/human-ai/' },
] as const;

// Restored from the live Open War Studies homepage on 2026-08-16; visible text preserved unchanged.
---

<BaseLayout title={formatDocumentTitle(t['home.title'], t['brand.name'])} withIntro>
  <article id="route-root" class="page">
    <p class="page-label">{t['home.label']}</p>
    <h1 tabindex="-1">{t['home.title']}</h1>
    <blockquote class="page-quote">{t['home.claim']}</blockquote>
    <p class="page-lead">{t['home.lead']}</p>
    <section class="card card-full">
      <h2>{t['home.not_site.title']}</h2>
      <ul class="card-list">
        {notItems.map((n) => <li>{t[`home.not_site.item_${n}`]}</li>)}
      </ul>
    </section>
    <div class="card-grid">
      {
        previews.map(({ title, body, path }) => (
          <a class="card" href={getRelativeLocaleUrl(locale, path)}>
            <h3>{t[title]}</h3>
            <p>{t[body]}</p>
          </a>
        ))
      }
    </div>
  </article>
</BaseLayout>
