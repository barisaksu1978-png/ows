---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDocumentTitle, getUi } from '../../i18n';

const t = getUi(Astro.currentLocale ?? 'tr');
const cards = ['roles', 'not_oracle', 'trace'] as const;
---

<BaseLayout title={formatDocumentTitle(t['human_ai.title'], t['brand.name'])} description={t['human_ai.lead']}>
  <article id="route-root" class="page">
    <p class="page-label">{t['human_ai.label']}</p>
    <h1>{t['human_ai.title']}</h1>
    <p class="page-lead">{t['human_ai.lead']}</p>

    <div class="card-grid">
      {
        cards.map((id) => (
          <section class="card">
            <h2>{t[`human_ai.card.${id}.title`]}</h2>
            <p>{t[`human_ai.card.${id}.body`]}</p>
          </section>
        ))
      }
    </div>
  </article>
</BaseLayout>
