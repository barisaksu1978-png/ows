---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDocumentTitle, getUi, type Locale } from '../../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getAtlasEntry, listAtlasLocales, pickLocalized } from '../../lib/atlas';
import { getDossierEntry, pickLocalized as pickDossierLocalized } from '../../lib/dossiers';

const atlasImages = import.meta.glob<{ default: ImageMetadata }>([
  '/src/assets/atlas/*.{jpg,jpeg,png,webp,gif}',
  '/src/assets/intro-map.jpg',
]);

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const locale = (Astro.currentLocale ?? 'tr') as Locale;
const t = getUi(locale);

const entry = await getAtlasEntry(slug, locale);
if (!entry) {
  throw new Error(`Missing atlas content for ${slug} in locale ${locale}`);
}

const { Content } = await render(entry);
const { data } = entry;

let mapImage: ImageMetadata | null = null;
if (data.image) {
  const atlasPath = `/src/assets/atlas/${data.image}`;
  const rootPath = `/src/assets/${data.image}`;
  const match = atlasImages[atlasPath] ?? atlasImages[rootPath];
  if (match) mapImage = (await match()).default;
}

const title = pickLocalized(data.title, locale);
const summary = pickLocalized(data.summary, locale);
const caption = data.publisher
  ? `${data.source} · ${data.publisher}`
  : data.source;

const hreflangLocales = await listAtlasLocales(slug);
const relatedDossierLinks = (
  await Promise.all(
    data.relatedDossiers.map(async (dossierSlug) => {
      const dossierEntry = await getDossierEntry(dossierSlug, locale);
      if (!dossierEntry) return null;
      return {
        slug: dossierSlug,
        label: pickDossierLocalized(dossierEntry.data.title, locale),
        href: getRelativeLocaleUrl(locale, `/dossiers/${dossierSlug}/`),
      };
    }),
  )
).filter((link) => link != null);
---

<BaseLayout title={formatDocumentTitle(title, t['brand.name'])} description={summary} hreflangLocales={hreflangLocales}>
  <article id="route-root" class="page atlas-detail">
    <p class="page-label">{t['atlas.label']}</p>

    <div class="tag-row atlas-badges">
      <span class="tag">{t['atlas.meta.period']}: {data.period}</span>
      {
        data.geography && (
          <span class="tag">{data.geography}</span>
        )
      }
      <span class="tag">{t['atlas.meta.risk']}: {t[`risk.${data.riskLevel}`]}</span>
    </div>

    <header class="atlas-header">
      <h1>{title}</h1>
    </header>

    {
      mapImage && (
        <figure class="atlas-figure">
          <Image
            src={mapImage}
            alt={title}
            widths={[720, 960, 1280, 1600]}
            sizes="(max-width: 960px) 100vw, 960px"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="atlas-caption">{caption}</figcaption>
        </figure>
      )
    }

    <dl class="atlas-meta">
      <div class="atlas-meta-item">
        <dt>{t['atlas.meta.period']}</dt>
        <dd>{data.period}</dd>
      </div>
      <div class="atlas-meta-item">
        <dt>{t['atlas.meta.source']}</dt>
        <dd>{data.source}</dd>
      </div>
      {
        data.publisher && (
          <div class="atlas-meta-item">
            <dt>{t['atlas.meta.publisher']}</dt>
            <dd>{data.publisher}</dd>
          </div>
        )
      }
      {
        data.geography && (
          <div class="atlas-meta-item">
            <dt>{t['atlas.meta.geography']}</dt>
            <dd>{data.geography}</dd>
          </div>
        )
      }
    </dl>

    <div class="atlas-body atlas-prose">
      <Content />
    </div>

    {
      relatedDossierLinks.length > 0 && (
        <section class="dossier-related atlas-related">
          <h2 class="dossier-related-title">{t['atlas.meta.dossiers']}</h2>
          <ul class="dossier-related-list">
            {
              relatedDossierLinks.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
